#check wether the number is prime
num=int(input("Enter a number:"))
count=0
for i in range(1,num+1):
    if num%i==0:
        count+=1
if count==2:
    print("prime")
else:
    print("not prime")
#primes in range
start = int(input("Enter start: "))
end = int(input("Enter end: "))

for n in range(start, end + 1):
    if n < 2:
        continue

    count = 0

    for i in range(1, n + 1):
        if n % i == 0:
            count += 1

    if count == 2:
        print(n, end=" ")
